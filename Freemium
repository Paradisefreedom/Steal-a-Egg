local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua"))()

-- WINDOWS
local Window = Library:CreateWindow({
    Title = "ShinyLeak",
    Footer = "v1.0.0",
    ToggleKeybind = Enum.KeyCode.RightControl,
    Center = true,
    AutoShow = true
})

-- TABS
local MainTab = Window:AddTab("Main", "home")
local LeftGroupbox = MainTab:AddLeftGroupbox("Settings")
local RightGroupbox = MainTab:AddRightGroupbox("Information")

-- TAB BOXES
local Tabbox = MainTab:AddLeftTabbox("Extra Settings")
local Tab1 = Tabbox:AddTab("General")
local Tab2 = Tabbox:AddTab("Advanced")

-- BUTTONS
LeftGroupbox:AddButton({
    Text = "Auto Farm Eggs",
    Func = function()
        -- 1. Get the local player and their character
        local player = Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local rootPart = character:WaitForChild("HumanoidRootPart")
        
        -- 2. Find the egg in the workspace
        local egg = workspace:FindFirstChild("Egg")
        
        if egg and rootPart then
            local targetPosition = egg:GetPivot().Position
            
            -- 3. Calculate distance and time to make the flight speed consistent
            local distance = (rootPart.Position - targetPosition).Magnitude
            local speed = 50 -- You can adjust this number to fly faster or slower
            local timeToReach = distance / speed
            
            -- 4. Create and play the hover/fly animation (Tween)
            local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
            local flyTween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPosition)})
            
            flyTween:Play()
            print("Flying to egg at: " .. tostring(targetPosition))
        else
            warn("Could not find the Egg in workspace or your character hasn't loaded!")
        end
    end,
    DoubleClick = false,
    Tooltip = "Makes you hover/fly directly to the egg"
})
