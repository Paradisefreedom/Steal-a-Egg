-- Helper function to find all eggs in workspace
local function getAllEggs()
    local eggs = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            if v.Name == "Egg" or string.find(v.Name, "Egg") then
                table.insert(eggs, v)
            end
        end
    end
    return eggs
end

-- ESP Toggle (applies to all eggs)
local espEnabled = false
AutoEggGroupbox:AddToggle("Enable Egg ESP", {
    Default = false,
    Callback = function(value)
        espEnabled = value
        local eggs = getAllEggs()
        for _, egg in pairs(eggs) do
            if value then
                if not egg:FindFirstChild("ESP_Highlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "ESP_Highlight"
                    hl.FillColor = Color3.fromRGB(255, 255, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = egg
                end
            else
                local hl = egg:FindFirstChild("ESP_Highlight")
                if hl then hl:Destroy() end
            end
        end
        if not value then
            -- Remove highlights from any eggs that might appear later
            workspace.DescendantAdded:Connect(function(desc)
                if (desc:IsA("Model") or desc:IsA("BasePart")) and desc.Name == "Egg" then
                    local hl = desc:FindFirstChild("ESP_Highlight")
                    if hl then hl:Destroy() end
                end
            end)
        end
    end
})

-- Auto Farm Eggs Button
AutoEggGroupbox:AddButton({
    Text = "Auto Farm Eggs",
    Func = function()
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")

        local eggs = getAllEggs()
        if #eggs == 0 then
            Library:Notify({ Title = "Error", Description = "No eggs found!", Time = 3 })
            return
        end

        -- Choose the first egg
        local egg = eggs[1]
        local targetPosition = egg:GetPivot().Position
        print("Egg found at:", targetPosition)

        humanoid:ChangeState(Enum.HumanoidStateType.Flying)
        humanoid:MoveTo(targetPosition)

        local timeout = 10
        local startTime = tick()
        repeat
            task.wait(0.1)
            humanoid:MoveTo(targetPosition)
            local distance = (rootPart.Position - targetPosition).Magnitude
            if distance < 5 then
                print("Reached egg!")
                break
            end
            if tick() - startTime > timeout then
                print("Movement timed out, teleporting...")
                rootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
                break
            end
        until false

        -- Try to interact (ProximityPrompt or ClickDetector)
        local prompt = egg:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            prompt:InputHoldBegin()
        end
        local click = egg:FindFirstChildOfClass("ClickDetector")
        if click then
            fireclickdetector(click)
        end
    end
})

-- Teleport to Egg Button
AutoEggGroupbox:AddButton({
    Text = "Teleport to Egg",
    Func = function()
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local eggs = getAllEggs()
        if #eggs > 0 then
            local egg = eggs[1]
            character:SetPrimaryPartCFrame(egg:GetPivot() * CFrame.new(0, 3, 0))
            Library:Notify({ Title = "Teleported", Description = "Teleported to egg!", Time = 2 })
        else
            Library:Notify({ Title = "Error", Description = "No eggs found!", Time = 2 })
        end
    end
})

