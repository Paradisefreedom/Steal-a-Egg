-- ==========================================
-- CORE SYSTEMS: FILTERING & CACHING
-- ==========================================
local function IsInPlayerBase(obj)
    local ancestor = obj.Parent
    while ancestor and ancestor ~= game do
        local name = ancestor.Name:lower()
        if name:match("base") or name:match("plot") or name:match("garden") or name:match("tycoon") or name:match("player") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

task.spawn(function()
    while task.wait(1) do
        local newCache = {}
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name:lower():match("egg") then
                if not IsInPlayerBase(obj) then
                    if obj:IsA("BasePart") then
                        table.insert(newCache, obj)
                    elseif obj:IsA("Model") then
                        local physicalPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                        if physicalPart then
                            table.insert(newCache, physicalPart)
                        end
                    end
                end
            end
        end
        EggCache = newCache
    end
end)

-- ==========================================
-- CORE SYSTEMS: VISUALS (ESP)
-- ==========================================
local function UpdateESP()
    for _, child in pairs(ESPFolder:GetChildren()) do
        child:Destroy()
    end

    if not getgenv().ESPEnabled then return end

    local count = 0
    for _, eggPart in pairs(EggCache) do
        if count >= 30 then break end
        
        local highlight = Instance.new("Highlight")
        highlight.Adornee = eggPart.Parent:IsA("Model") and eggPart.Parent or eggPart
        highlight.FillColor = Color3.fromRGB(255, 215, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.1
        highlight.Parent = ESPFolder
        
        count = count + 1
    end
end

task.spawn(function()
    while task.wait(0.5) do
        UpdateESP()
    end
end)

-- ==========================================
-- CORE SYSTEMS: TARGETING & NOCLIP
-- ==========================================
local function GetClosestEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestEgg = nil
    local shortestDistance = math.huge

    for _, targetPart in pairs(EggCache) do
        if targetPart and targetPart.Parent then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestEgg = targetPart
            end
        end
    end
    return closestEgg
end

local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- ==========================================
-- NEW: CUSTOM TERRAIN-HUGGING HOVER ENGINE
-- ==========================================
local function FlyToTarget(targetPart)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid and humanoid.Health <= 0 then return end

    rootPart.Anchored = true 
    
    local startPos = rootPart.Position
    local targetPos = targetPart.Position
    
    -- Calculate 2D horizontal distance only
    local horizontalDist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(startPos.X, 0, startPos.Z)).Magnitude
    local timeToReach = horizontalDist / getgenv().FlightSpeed
    local startTime = tick()
    
    -- Exclude player from raycasting so we don't accidentally measure our own body
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local flightConnection
    flightConnection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / timeToReach, 0, 1)
        
        -- Move smoothly on X and Z axis
        local currentX = startPos.X + (targetPos.X - startPos.X) * alpha
        local currentZ = startPos.Z + (targetPos.Z - startPos.Z) * alpha
        
        -- Raycast strictly straight down from high up to find the physical ground below us
        local rayOrigin = Vector3.new(currentX, 1000, currentZ)
        local rayDirection = Vector3.new(0, -2000, 0)
        local rayResult = Workspace:Raycast(rayOrigin, rayDirection, rayParams)
        
        -- Default to egg height, but if ground is detected, hover 4 studs above it
        local currentY = targetPos.Y + 3 
        if rayResult then
            currentY = rayResult.Position.Y + 4
        end
        
        rootPart.CFrame = CFrame.new(currentX, currentY, currentZ)
        
        -- Stop when we reach the destination
        if alpha >= 1 or not getgenv().AutoFarmEnabled then
            flightConnection:Disconnect()
        end
    end)
    
    -- Yield the script until the flight loop finishes
    repeat task.wait() until tick() - startTime >= timeToReach or not getgenv().AutoFarmEnabled
    
    if flightConnection then flightConnection:Disconnect() end
    
    rootPart.Anchored = false 
    rootPart.Velocity = Vector3.zero -- Prevent flinging

    -- Force collection
    if targetPart and rootPart and firetouchinterest and getgenv().AutoFarmEnabled then
        firetouchinterest(rootPart, targetPart, 0)
        task.wait(0.05)
        firetouchinterest(rootPart, targetPart, 1)
    end
end

-- ==========================================
-- CORE SYSTEMS: AUTOMATION (UPGRADES & CLAIMING)
-- ==========================================
local function ExecuteUpgrades()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:lower():match("upgrade") then
            if obj:IsA("ProximityPrompt") then
                fireproximityprompt(obj, 1)
            elseif obj:IsA("BasePart") and firetouchinterest then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    firetouchinterest(char.HumanoidRootPart, obj, 0)
                    task.wait(0.01)
                    firetouchinterest(char.HumanoidRootPart, obj, 1)
                end
            end
        end
    end

    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:match("upgrade") or name:match("buy") or name:match("purchase") then
                pcall(function() remote:FireServer() end)
                pcall(function() remote:FireServer("Treadmill") end)
            end
        end
    end
end

local function ExecuteClaimIndex()
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:match("claim") or name:match("index") or name:match("reward") or name:match("quest") then
                pcall(function() remote:FireServer() end)
                pcall(function() remote:FireServer("ClaimAll") end)
                pcall(function() remote:FireServer("Index") end)
            end
        elseif remote:IsA("RemoteFunction") then
            local name = remote.Name:lower()
            if name:match("claim") or name:match("index") then
                task.spawn(function()
                    pcall(function() remote:InvokeServer() end)
                end)
            end
        end
    end
end

