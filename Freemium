-- Left groupbox: Auto Egg
local AutoEggGroupbox = AutoFarmTab:AddLeftGroupbox("Auto Egg")

-- ESP Toggle
AutoEggGroupbox:AddToggle("Enable Egg ESP", {
    Default = false,
    Callback = function(value)
        local egg = workspace:FindFirstChild("Egg")
        if not egg then return end
        if value then
            if not egg:FindFirstChild("ESP_Highlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "ESP_Highlight"
                hl.FillColor = Color3.fromRGB(255, 255, 0)
                hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.Parent = egg
            end
        else
            local hl = egg:FindFirstChild("ESP_Highlight")
            if hl then hl:Destroy() end
        end
    end
})

-- Auto Farm Eggs Button
AutoEggGroupbox:AddButton({
    Text = "Auto Farm Eggs",
    Func = function()
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local egg = workspace:FindFirstChild("Egg")
        if egg then
            local targetPosition = egg:GetPivot().Position
            print("Egg position:", targetPosition)
            humanoid:MoveTo(targetPosition)
            if humanoid:GetState() ~= Enum.HumanoidStateType.Flying then
                humanoid:ChangeState(Enum.HumanoidStateType.Flying)
            end
            repeat
                task.wait()
                humanoid:MoveTo(targetPosition)
            until (character.HumanoidRootPart.Position - targetPosition).Magnitude < 5
        else
            print("Egg not found")
        end
    end
})

