local function autoFarmEggs()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    -- Find the egg (search direct children and descendants)
    local egg = workspace:FindFirstChild("Egg")
    if not egg then
        -- Try searching all descendants (in case it's nested)
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "Egg" and (v:IsA("Model") or v:IsA("BasePart")) then
                egg = v
                break
            end
        end
    end

    if not egg then
        Library:Notify({
            Title = "Error",
            Description = "Egg not found!",
            Time = 3
        })
        return
    end

    local targetPosition = egg:GetPivot().Position
    print("Egg found at:", targetPosition)

    -- Enable flying
    humanoid:ChangeState(Enum.HumanoidStateType.Flying)

    -- Attempt to move to the egg
    humanoid:MoveTo(targetPosition)

    -- Wait until close enough or timeout
    local timeout = 10
    local startTime = tick()
    repeat
        task.wait(0.1)
        humanoid:MoveTo(targetPosition)
        local distance = (rootPart.Position - targetPosition).Magnitude
        if distance < 5 then
            print("Reached egg!")
            break
        end
        -- If movement is stuck, teleport as fallback
        if tick() - startTime > timeout then
            print("Movement timed out, teleporting...")
            rootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
            break
        end
    until false

    -- After reaching, optionally collect the egg (if possible)
    -- You can add code to click the egg or interact with it here
end
