-- CORE FUNCTIONS

-- 1. Dynamic Egg Targeting System
-- In "Steal an egg", eggs can be nested in folders, models, or spawned dynamically. 
-- This function calculates the absolute closest egg to your character to optimize travel time.
local function GetClosestEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestEgg = nil
    local shortestDistance = math.huge

    -- Broad search: iterates through workspace to find any BasePart or Model named "Egg"
    -- If the game uses a specific folder (e.g., workspace.Eggs), it will still find it.
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:lower():match("egg") then
            -- Determine the position regardless of whether it's a Model or a Part
            local targetPos = nil
            local targetPart = nil

            if obj:IsA("Model") and obj.PrimaryPart then
                targetPos = obj:GetPivot().Position
                targetPart = obj.PrimaryPart
            elseif obj:IsA("BasePart") then
                targetPos = obj.Position
                targetPart = obj
            end

            -- Validate and calculate distance
            if targetPos and targetPart then
                local distance = (rootPart.Position - targetPos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestEgg = targetPart
                end
            end
        end
    end

    return closestEgg
end

-- 2. Anti-Collision (Noclip) Engine
-- Prevents your character from getting stuck on walls, terrain, or buildings while flying.
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- 3. Tween Flight Logic & Touch Bypass
local function FlyToTarget(targetPart)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local humanoid = character:FindFirstChild("Humanoid")
    
    -- Suspend gravity effects so the character doesn't glitch during flight
    if humanoid then humanoid.PlatformStand = true end

    local distance = (rootPart.Position - targetPart.Position).Magnitude
    local timeToReach = distance / getgenv().FlightSpeed

    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    local flightTween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPart.Position)})
    
    flightTween:Play()
    flightTween.Completed:Wait()

    -- Failsafe: Force a physical touch event on the server to ensure the egg is collected
    if targetPart and rootPart then
        if firetouchinterest then
            firetouchinterest(rootPart, targetPart, 0)
            task.wait(0.1)
            firetouchinterest(rootPart, targetPart, 1)
        end
    end
    
    if humanoid then humanoid.PlatformStand = false end
end

