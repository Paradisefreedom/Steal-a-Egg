end)

-- ESP TAB CONTENT
local ESPLeftGroupbox = ESPTab:AddLeftGroupbox("Egg ESP")
local ESPRightGroupbox = ESPTab:AddRightGroupbox("Settings")

-- ESP Function to highlight eggs
local function enableEggESP()
    local egg = workspace:FindFirstChild("Egg")
    if egg then
        -- Create highlight for the egg
        if not egg:FindFirstChild("ESP_Highlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Highlight"
            highlight.FillColor = Color3.fromRGB(255, 255, 0) -- Yellow fill
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0) -- Red outline
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = egg
        end
        print("ESP enabled for egg")
    else
        print("Egg not found in workspace")
    end
end

-- Function to disable ESP
local function disableEggESP()
    local egg = workspace:FindFirstChild("Egg")
    if egg and egg:FindFirstChild("ESP_Highlight") then
        egg:FindFirstChild("ESP_Highlight"):Destroy()
        print("ESP disabled for egg")
    end
end

-- ESP Toggle
ESPLeftGroupbox:AddToggle("Egg ESP", {
    Default = false,
    Callback = function(value)
        if value then
            enableEggESP()
        else
            disableEggESP()
        end
    end
})

