-- ==========================================
-- CORE SYSTEMS: BASE & AREA DETECTION
-- ==========================================
local function IsInPlayerBase(obj)
    local ancestor = obj.Parent
    while ancestor and ancestor ~= game do
        local name = ancestor.Name:lower()
        if name:match("base") or name:match("plot") or name:match("garden") or name:match("tycoon") or name:match("player") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

-- Matches the official zones to folder/model names in the game
local function GetEggArea(obj)
    local curr = obj.Parent
    while curr and curr ~= Workspace do
        local name = curr.Name:lower()
        if name:match("forest") then return "Forest" end
        if name:match("lake") then return "Lake" end
        if name:match("desert") then return "Desert" end
        if name:match("jungle") then return "Jungle" end
        if name:match("snow") then return "Snow" end
        if name:match("volcano") then return "Volcano" end
        if name:match("abyss") or name:match("ocean") then return "Abyss Ocean" end
        if name:match("prehistoric") then return "Prehistoric" end
        if name:match("cosmic") then return "Cosmic" end
        if name:match("cherry blossom") or name:match("cherry") then return "Cherry Blossom" end
        if name:match("titan temple") or name:match("titan") then return "Titan Temple" end
        curr = curr.Parent
    end
    return "Unknown"
end

-- Finds player's base location
local function GetMyBaseCFrame()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestTreadmill = nil
    local shortestDistance = math.huge

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:lower():match("treadmill") then
            local part = nil
            if obj:IsA("BasePart") then part = obj
            elseif obj:IsA("Model") and obj.PrimaryPart then part = obj.PrimaryPart
            elseif obj:IsA("Model") then part = obj:FindFirstChildWhichIsA("BasePart", true) end

            if part then
                local dist = (rootPart.Position - part.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestTreadmill = part
                end
            end
        end
    end

    if closestTreadmill then
        return closestTreadmill.CFrame
    end
    return rootPart.CFrame
end

-- Egg Cache Builder (Filters by Official Area)
task.spawn(function()
    while task.wait(1) do
        local newCache = {}
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name:lower():match("egg") and not IsInPlayerBase(obj) then
                local physicalPart = nil
                if obj:IsA("BasePart") then physicalPart = obj
                elseif obj:IsA("Model") then physicalPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end

                if physicalPart then
                    local areaName = GetEggArea(physicalPart)
                    if getgenv().SelectedArea == "All" or areaName == getgenv().SelectedArea then
                        table.insert(newCache, physicalPart)
                    end
                end
            end
        end
        EggCache = newCache
    end
end)

-- ==========================================
-- CORE SYSTEMS: VISUALS (ESP)
-- ==========================================
local function UpdateESP()
    for _, child in pairs(ESPFolder:GetChildren()) do
        child:Destroy()
    end

    if not getgenv().ESPEnabled then return end

    local count = 0
    for _, eggPart in pairs(EggCache) do
        if count >= 30 then break end
        local highlight = Instance.new("Highlight")
        highlight.Adornee = eggPart.Parent:IsA("Model") and eggPart.Parent or eggPart
        highlight.FillColor = Color3.fromRGB(255, 215, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.1
        highlight.Parent = ESPFolder
        count = count + 1
    end
end

task.spawn(function()
    while task.wait(0.5) do UpdateESP() end
end)

-- ==========================================
-- CORE SYSTEMS: NOCLIP & MOVEMENT
-- ==========================================
local function GetClosestEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestEgg = nil
    local shortestDistance = math.huge

    for _, targetPart in pairs(EggCache) do
        if targetPart and targetPart.Parent then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestEgg = targetPart
            end
        end
    end
    return closestEgg
end

local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    -- 1. Noclip the player
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
                
                -- 2. TREADMILL BYPASS: Force all treadmills to let you ghost through them
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj.Name:lower():match("treadmill") and obj:IsA("BasePart") then
                        obj.CanCollide = false
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- SURFACE-LEVEL GLIDE: Uses X, Z normally, but offsets Y to keep you precisely at ground level.
local function GlideTo(targetPosition)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    local rootPart = character.HumanoidRootPart

    -- By adding +3 studs to the Y-axis, your torso sits exactly above the egg/ground.
    -- This prevents your legs from dipping into the floor, and stops you from flying.
    local safeTargetPosition = Vector3.new(targetPosition.X, targetPosition.Y + 3, targetPosition.Z)

    while getgenv().AutoFarmEnabled and targetPosition do
        local distance = (safeTargetPosition - rootPart.Position).Magnitude
        if distance < 3 then break end
        
        local deltaTime = RunService.Heartbeat:Wait()
        local direction = (safeTargetPosition - rootPart.Position).Unit
        local step = direction * (getgenv().FlightSpeed * deltaTime)
        
        rootPart.CFrame = rootPart.CFrame + step
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
    return true
end

