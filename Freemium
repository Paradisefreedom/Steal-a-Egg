-- Left groupbox: Auto Egg
local AutoEggGroupbox = AutoFarmTab:AddLeftGroupbox("Auto Egg")

-- ESP Toggle
AutoEggGroupbox:AddToggle("Enable Egg ESP", {
    Default = false,
    Callback = function(value)
        local egg = workspace:FindFirstChild("Egg") or workspace:FindFirstChild("Egg", true)
        if not egg then return end
        if value then
            if not egg:FindFirstChild("ESP_Highlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "ESP_Highlight"
                hl.FillColor = Color3.fromRGB(255, 255, 0)
                hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.Parent = egg
            end
        else
            local hl = egg:FindFirstChild("ESP_Highlight")
            if hl then hl:Destroy() end
        end
    end
})

-- Auto Farm Eggs Button
AutoEggGroupbox:AddButton({
    Text = "Auto Farm Eggs",
    Func = function()
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")

        -- Find egg
        local egg = workspace:FindFirstChild("Egg")
        if not egg then
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name == "Egg" and (v:IsA("Model") or v:IsA("BasePart")) then
                    egg = v
                    break
                end
            end
        end

        if not egg then
            Library:Notify({
                Title = "Error",
                Description = "Egg not found!",
                Time = 3
            })
            return
        end

        local targetPosition = egg:GetPivot().Position
        print("Egg found at:", targetPosition)

        -- Set flying
        humanoid:ChangeState(Enum.HumanoidStateType.Flying)

        -- Move to egg
        humanoid:MoveTo(targetPosition)

        local timeout = 10
        local startTime = tick()
        repeat
            task.wait(0.1)
            humanoid:MoveTo(targetPosition)
            local distance = (rootPart.Position - targetPosition).Magnitude
            if distance < 5 then
                print("Reached egg!")
                break
            end
            if tick() - startTime > timeout then
                print("Movement timed out, teleporting...")
                rootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
                break
            end
        until false

        -- Optionally interact with egg (e.g., ProximityPrompt)
        local proximity = egg:FindFirstChildOfClass("ProximityPrompt")
        if proximity then
            proximity:InputHoldBegin()
        end
    end
})

-- Teleport to Egg Button
AutoEggGroupbox:AddButton({
    Text = "Teleport to Egg",
    Func = function()
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local egg = workspace:FindFirstChild("Egg")
        if egg then
            local targetCFrame = egg:GetPivot() * CFrame.new(0, 3, 0)
            character:SetPrimaryPartCFrame(targetCFrame)
            Library:Notify({
                Title = "Teleported",
                Description = "Teleported to egg!",
                Time = 2
            })
        else
            Library:Notify({
                Title = "Error",
                Description = "Egg not found!",
                Time = 2
            })
        end
    end
})

