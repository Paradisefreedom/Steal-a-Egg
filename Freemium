-- AUTO FARM EGG FUNCTION
local function autoFarmEggs()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local egg = workspace:FindFirstChild("Egg")
    
    if egg then
        local targetPosition = egg:GetPivot().Position
        print("Egg position: ", targetPosition)
        
        -- Make the character hover/fly to the egg
        humanoid:MoveTo(targetPosition)
        
        -- Optional: Set the humanoid to flying state for better movement
        if humanoid:GetState() ~= Enum.HumanoidStateType.Flying then
            humanoid:ChangeState(Enum.HumanoidStateType.Flying)
        end
        
        -- Wait until character reaches the destination
        repeat
            task.wait()
            humanoid:MoveTo(targetPosition)
        until (character.HumanoidRootPart.Position - targetPosition).Magnitude < 5
    else
        print("Egg not found in workspace")
    end
end

-- ADD BUTTON TO GENERAL TAB (inside the groupbox)
GeneralGroupbox:AddButton("Auto Farm Eggs", function()
    autoFarmEggs()
end)

-- ESP TAB CONTENT
local ESPGroupbox = ESPTab:AddLeftGroupbox("Egg ESP")

-- ESP toggle and highlight logic
local espEnabled = false

local function updateESP()
    local egg = workspace:FindFirstChild("Egg")
    if not egg then
        print("Egg not found in workspace")
        return
    end
    
    if espEnabled then
        -- Create highlight if not exists
        if not egg:FindFirstChild("ESP_Highlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Highlight"
            highlight.FillColor = Color3.fromRGB(255, 255, 0) -- Yellow fill
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0) -- Red outline
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = egg
        end
    else
        -- Remove highlight if exists
        if egg:FindFirstChild("ESP_Highlight") then
            egg:FindFirstChild("ESP_Highlight"):Destroy()
        end
    end
end

ESPGroupbox:AddToggle("Enable Egg ESP", {
    Default = false,
    Callback = function(value)
        espEnabled = value
        updateESP()
    end
})

ESPGroupbox:AddLabel("Highlights eggs through walls")

-- Also handle if egg is added later
workspace.ChildAdded:Connect(function(child)
    if child.Name == "Egg" and espEnabled then
        updateESP()
    end
end)
