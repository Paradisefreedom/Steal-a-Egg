        else
            if prompt.InputHoldBegin then prompt:InputHoldBegin() end
            task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.5)
            if prompt.InputHoldEnd then prompt:InputHoldEnd() end
        end
    elseif firetouchinterest then
        local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            firetouchinterest(rootPart, targetPart, 0)
            task.wait(0.01)
            firetouchinterest(rootPart, targetPart, 1)
        end
    end
end

local function DropEggAtPlot()
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:match("drop") or name:match("place") or name:match("deposit") or name:match("deliver") then
                pcall(function() remote:FireServer() end)
            end
        end
    end

    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local parentName = obj.Parent and obj.Parent.Name:lower() or ""
                if parentName:match("drop") or parentName:match("base") or parentName:match("deposit") or parentName:match("nest") then
                    if fireproximityprompt then
                        fireproximityprompt(obj, 0)
                    end
                end
            end
        end
    end
end

local function ExecuteStealAndReturnLoop(targetEgg)
    if not targetEgg or not targetEgg.Parent then return end
    
    -- Glide smoothly at surface level
    GlideTo(targetEgg.Position)
    
    -- Hold E to steal
    InteractHoldE(targetEgg)
    task.wait(0.3)

    -- Glide safely back to base at surface level
    local baseCFrame = GetMyBaseCFrame()
    if baseCFrame then
        GlideTo(baseCFrame.Position)
        DropEggAtPlot()
        task.wait(0.5)
    end
end

