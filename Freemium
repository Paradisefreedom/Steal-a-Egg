-- AUTO FARM EGG FUNCTION
local function autoFarmEggs()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local egg = workspace:FindFirstChild("Egg")

    if egg then
        local targetPosition = egg:GetPivot().Position
        print("Egg position: ", targetPosition)

        -- Move to egg
        humanoid:MoveTo(targetPosition)
        
        -- Enable flying for smooth movement
        if humanoid:GetState() ~= Enum.HumanoidStateType.Flying then
            humanoid:ChangeState(Enum.HumanoidStateType.Flying)
        end

        -- Keep moving until close enough
        repeat
            task.wait()
            humanoid:MoveTo(targetPosition)
        until (character.HumanoidRootPart.Position - targetPosition).Magnitude < 5
    else
        print("Egg not found in workspace")
    end
end

-- BUTTON
FarmingGroupbox:AddButton("Auto Farm Eggs", function()
    autoFarmEggs()
end)

-- ESP TAB
local ESPGroupbox = ESPTab:AddLeftGroupbox("Egg ESP")

local espEnabled = false

local function updateESP()
    local egg = workspace:FindFirstChild("Egg")
    if not egg then
        print("Egg not found")
        return
    end

    if espEnabled then
        -- Add highlight if not already there
        if not egg:FindFirstChild("ESP_Highlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Highlight"
            highlight.FillColor = Color3.fromRGB(255, 255, 0)   -- yellow fill
            highlight.OutlineColor = Color3.fromRGB(255, 0, 0)  -- red outline
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = egg
        end
    else
        -- Remove highlight
        local hl = egg:FindFirstChild("ESP_Highlight")
        if hl then
            hl:Destroy()
        end
    end
end

ESPGroupbox:AddToggle("Enable Egg ESP", {
    Default = false,
    Callback = function(value)
        espEnabled = value
        updateESP()
    end
})

ESPGroupbox:AddLabel("Highlights eggs through walls")

-- Auto-update ESP when an egg is added later
workspace.ChildAdded:Connect(function(child)
    if child.Name == "Egg" and espEnabled then
        updateESP()
    end
end)
