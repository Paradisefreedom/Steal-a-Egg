-- ==========================================
-- CORE SYSTEMS: BASE & AREA DETECTION
-- ==========================================
local function IsInPlayerBase(obj)
    local ancestor = obj.Parent
    while ancestor and ancestor ~= game do
        local name = ancestor.Name:lower()
        if name:match("base") or name:match("plot") or name:match("garden") or name:match("tycoon") or name:match("player") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

-- Detects parent zone/area name for filtering
local function GetEggArea(obj)
    local curr = obj.Parent
    while curr and curr ~= Workspace do
        if curr:IsA("Folder") or curr:IsA("Model") then
            local name = curr.Name
            if not name:lower():match("egg") and not name:lower():match("workspace") then
                return name
            end
        end
        curr = curr.Parent
    end
    return "Main Map"
end

-- Finds player's base location via their local treadmill or plot
local function GetMyBaseCFrame()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestTreadmill = nil
    local shortestDistance = math.huge

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:lower():match("treadmill") then
            local part = nil
            if obj:IsA("BasePart") then part = obj
            elseif obj:IsA("Model") and obj.PrimaryPart then part = obj.PrimaryPart
            elseif obj:IsA("Model") then part = obj:FindFirstChildWhichIsA("BasePart", true) end

            if part then
                local dist = (rootPart.Position - part.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestTreadmill = part
                end
            end
        end
    end

    if closestTreadmill then
        return closestTreadmill.CFrame * CFrame.new(0, 3, 0)
    end
    
    return rootPart.CFrame -- Fallback to current location if base isn't found
end

-- Scans workspace and builds egg cache filtered by area
task.spawn(function()
    while task.wait(1) do
        local newCache = {}
        local areaSet = {["All"] = true}

        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name:lower():match("egg") and not IsInPlayerBase(obj) then
                local physicalPart = nil
                if obj:IsA("BasePart") then physicalPart = obj
                elseif obj:IsA("Model") then physicalPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end

                if physicalPart then
                    local areaName = GetEggArea(physicalPart)
                    areaSet[areaName] = true

                    if getgenv().SelectedArea == "All" or areaName == getgenv().SelectedArea then
                        table.insert(newCache, physicalPart)
                    end
                end
            end
        end

        EggCache = newCache

        -- Update Area List
        local updatedAreas = {}
        for area, _ in pairs(areaSet) do
            table.insert(updatedAreas, area)
        end
        DiscoveredAreas = updatedAreas
    end
end)

-- ==========================================
-- CORE SYSTEMS: VISUALS (ESP)
-- ==========================================
local function UpdateESP()
    for _, child in pairs(ESPFolder:GetChildren()) do
        child:Destroy()
    end

    if not getgenv().ESPEnabled then return end

    local count = 0
    for _, eggPart in pairs(EggCache) do
        if count >= 30 then break end
        
        local highlight = Instance.new("Highlight")
        highlight.Adornee = eggPart.Parent:IsA("Model") and eggPart.Parent or eggPart
        highlight.FillColor = Color3.fromRGB(255, 215, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.1
        highlight.Parent = ESPFolder
        
        count = count + 1
    end
end

task.spawn(function()
    while task.wait(0.5) do
        UpdateESP()
    end
end)

-- ==========================================
-- CORE SYSTEMS: NOCLIP & MOVEMENT
-- ==========================================
local function GetClosestEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestEgg = nil
    local shortestDistance = math.huge

    for _, targetPart in pairs(EggCache) do
        if targetPart and targetPart.Parent then
            local distance = (rootPart.Position - targetPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestEgg = targetPart
            end
        end
    end
    return closestEgg
end

local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- Frame-by-Frame Glide engine to position
local function GlideTo(targetPosition)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    local rootPart = character.HumanoidRootPart

    while getgenv().AutoFarmEnabled and targetPosition do
        local distance = (targetPosition - rootPart.Position).Magnitude
        if distance < 3 then break end
        
        local deltaTime = RunService.Heartbeat:Wait()
        local direction = (targetPosition - rootPart.Position).Unit
        local step = direction * (getgenv().FlightSpeed * deltaTime)
        
        rootPart.CFrame = rootPart.CFrame + step
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
    return true
end

-- Interacts with ProximityPrompt (Hold E) or touch fallback
local function InteractHoldE(targetPart)
    local prompt = targetPart:FindFirstChildWhichIsA("ProximityPrompt", true) 
                   or (targetPart.Parent and targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))

    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
            task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.5)
        else
            -- Hold key fallback if executor lacks fireproximityprompt
            if prompt.InputHoldBegin then prompt:InputHoldBegin() end
            task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.5)
            if prompt.InputHoldEnd then prompt:InputHoldEnd() end
        end
    elseif firetouchinterest then
        local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            firetouchinterest(rootPart, targetPart, 0)
            task.wait(0.01)
            firetouchinterest(rootPart, targetPart, 1)
        end
    end
end

-- Fires drop/place remotes or interacts with local plot drop zone
local function DropEggAtPlot()
    -- Fire common drop remotes
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:match("drop") or name:match("place") or name:match("deposit") or name:match("deliver") then
                pcall(function() remote:FireServer() end)
            end
        end
    end

    -- Trigger any local drop ProximityPrompts at your base
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local parentName = obj.Parent and obj.Parent.Name:lower() or ""
                if parentName:match("drop") or parentName:match("base") or parentName:match("deposit") or parentName:match("nest") then
                    if fireproximityprompt then
                        fireproximityprompt(obj, 0)
                    end
                end
            end
        end
    end
end

-- Full Farm Routine: Glide to Egg -> Hold E -> Glide to Base -> Place Down
local function ExecuteStealAndReturnLoop(targetEgg)
    if not targetEgg or not targetEgg.Parent then return end
    
    -- 1. Glide to Egg
    GlideTo(targetEgg.Position)
    
    -- 2. Pick up Egg (Hold E)
    InteractHoldE(targetEgg)
    task.wait(0.3)

    -- 3. Glide back to base plot
    local baseCFrame = GetMyBaseCFrame()
    if baseCFrame then
        GlideTo(baseCFrame.Position)
        
        -- 4. Drop / Place Egg
        DropEggAtPlot()
        task.wait(0.5)
    end
end

-- ==========================================
-- CORE SYSTEMS: AUTOMATION (UPGRADES & CLAIMING)
-- ==========================================
local function ExecuteUpgrades()
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:match("upgrade") or name:match("buy") or name:match("purchase") then
                pcall(function() remote:FireServer() end)
                pcall(function() remote:FireServer("Treadmill") end)
            end
        end
    end
end

local function ExecuteClaimIndex()
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:match("claim") or name:match("index") or name:match("reward") or name:match("quest") then
                pcall(function() remote:FireServer() end)
                pcall(function() remote:FireServer("ClaimAll") end)
                pcall(function() remote:FireServer("Index") end)
            end
        elseif remote:IsA("RemoteFunction") then
            local name = remote.Name:lower()
            if name:match("claim") or name:match("index") then
                task.spawn(function()
                    pcall(function() remote:InvokeServer() end)
                end)
            end
        end
    end
end

