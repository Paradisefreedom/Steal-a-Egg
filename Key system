--------------------------------------------------------------------------------
-- LOAD MAIN MENU FUNCTION
--------------------------------------------------------------------------------
local function LoadMainUI()
    ScreenGui:Destroy()

    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Paradisefreedom/Steal-a-Egg/refs/heads/main/Keymium"))()
    end)

    if not success then
        warn("Failed to load main script: " .. tostring(err))
    end
end

--------------------------------------------------------------------------------
-- BUTTON INTERACTIONS
--------------------------------------------------------------------------------
SubmitBtn.MouseButton1Click:Connect(function()
    if TextBox.Text == CORRECT_KEY then
        SubmitBtn.Text = "Success!"
        task.wait(0.5)
        LoadMainUI()
    else
        SubmitBtn.Text = "Invalid Key"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        task.wait(1.5)
        SubmitBtn.Text = "Check Key"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    end
end)

GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_URL)
        GetKeyBtn.Text = "Copied Link!"
        task.wait(1.5)
        GetKeyBtn.Text = "Get Key"
    else
        GetKeyBtn.Text = "Executor Unsupported"
        task.wait(1.5)
        GetKeyBtn.Text = "Get Key"
    end
end)
