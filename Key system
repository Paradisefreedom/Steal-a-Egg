local function LoadMainUI()
    -- Smooth exit fade animation
    local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1})
    fadeOut:Play()
    fadeOut.Completed:Wait()
    ScreenGui:Destroy()

    -- Load your main external menu script
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Paradisefreedom/Steal-a-Egg/refs/heads/main/Keymium"))()
    end)

    if not success then
        warn("Failed to load main script: " .. tostring(err))
    end
end

