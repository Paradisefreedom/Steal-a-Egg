--------------------------------------------------------------------------------
-- STEP 2: LOAD YOUR MAIN SCRIPT URL UPON SUCCESS
--------------------------------------------------------------------------------
local function LoadMainUI()
    -- Remove the key GUI screen
    ScreenGui:Destroy()

    -- Load your main menu script from GitHub
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Paradisefreedom/Steal-a-Egg/refs/heads/main/Keymium"))()
    end)

    if not success then
        warn("Failed to load main script: " .. tostring(err))
    end
end

