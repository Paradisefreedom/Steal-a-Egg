-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Define Services and Player
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- State variables
local _G = {
    AutoSteal = false,
    WaitTime = 0.5,
    Noclip = true
}

-- Create Window
local Window = Rayfield:CreateWindow({
    Name = "Brainrot Stealer | UNDETECTED",
    LoadingTitle = "Loading GUI...",
    LoadingSubtitle = "by Smart Stealer",
    ConfigurationSaving = {
       Enabled = false,
    },
    Discord = {
       Enabled = false,
    },
    KeySystem = false
})

-- Create Tab
local MainTab = Window:CreateTab("Auto Rob", 4483362458) -- 4483362458 is an icon ID

-- ==========================================
-- MAIN LOGIC
-- ==========================================

local function StartStealing()
    task.spawn(function()
        while _G.AutoSteal do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local plotsFolder = Workspace:FindFirstChild("Plots")
            
            if hrp and plotsFolder then
                
                -- Noclip Check
                if _G.Noclip then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end

                -- Loop through every player's plot
                for _, plot in pairs(plotsFolder:GetChildren()) do
                    if not _G.AutoSteal then break end
                    
                    -- Skip your own plot
                    if plot.Name ~= LocalPlayer.Name then
                        
                        local brainrots = plot:FindFirstChild("Brainrots")
                        if brainrots then
                            for _, spawn in pairs(brainrots:GetChildren()) do
                                if not _G.AutoSteal then break end
                                
                                local podium = spawn:FindFirstChild("Podium")
                                if podium then
                                    local attachment = podium:FindFirstChild("Attachment")
                                    if attachment then
                                        -- Locate the exact Steal button
                                        local stealPrompt = attachment:FindFirstChild("Steal") or attachment:FindFirstChildWhichIsA("ProximityPrompt")
                                        
                                        if stealPrompt and stealPrompt.Enabled then
                                            -- Teleport and Steal
                                            hrp.CFrame = podium.CFrame * CFrame.new(0, 3, 0)
                                            task.wait(0.2) -- Let the character settle
                                            
                                            fireproximityprompt(stealPrompt)
                                            task.wait(_G.WaitTime)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

-- ==========================================
-- UI ELEMENTS
-- ==========================================

MainTab:CreateToggle({
    Name = "Enable Auto Steal",
    CurrentValue = false,
    Flag = "AutoStealToggle",
    Callback = function(Value)
        _G.AutoSteal = Value
        if _G.AutoSteal then
            StartStealing()
        end
    end,
})

MainTab:CreateSlider({
    Name = "Steal Delay (Seconds)",
    Range = {0.1, 3.0},
    Increment = 0.1,
    Suffix = "s",
    CurrentValue = 0.5,
    Flag = "DelaySlider",
    Callback = function(Value)
        _G.WaitTime = Value
    end,
})

MainTab:CreateToggle({
    Name = "Auto Noclip",
    CurrentValue = true,
    Flag = "NoclipToggle",
    Callback = function(Value)
        _G.Noclip = Value
    end,
})

MainTab:CreateButton({
    Name = "Destroy GUI",
    Callback = function()
        Rayfield:Destroy()
        _G.AutoSteal = false
    end,
})
