-- Load Obsidian UI
local Obsidian = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/main/source.lua"))()

-- Define Services and Player
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- State variables
local _G = {
    AutoSteal = false,
    WaitTime = 0.5,
    Noclip = true
}

-- Create Window
local Window = Obsidian:Load({
    Title = "Steal a Brainrot [AUTO]",
    Theme = "Dark",
    Size = Vector2.new(450, 300),
    HideKey = Enum.KeyCode.RightShift
})

local MainTab = Window:Tab("Auto Rob")

MainTab:Toggle({
    Title = "Enable Auto Steal",
    Description = "Teleports to all other plots and fires the Steal prompts.",
    Default = false,
    Callback = function(Value)
        _G.AutoSteal = Value
        
        if _G.AutoSteal then
            task.spawn(function()
                while _G.AutoSteal do
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local plotsFolder = Workspace:FindFirstChild("Plots")
                    
                    if hrp and plotsFolder then
                        
                        -- Enable Noclip so you don't get stuck in walls while teleporting
                        if _G.Noclip then
                            for _, part in pairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                        end

                        -- Loop through every player's plot
                        for _, plot in pairs(plotsFolder:GetChildren()) do
                            if not _G.AutoSteal then break end
                            
                            -- Basic check to skip your own plot (Assumes plot is named after the player or has an Owner tag)
                            if plot.Name ~= LocalPlayer.Name then
                                
                                local brainrots = plot:FindFirstChild("Brainrots")
                                if brainrots then
                                    -- Loop through the podiums on the enemy's plot
                                    for _, spawn in pairs(brainrots:GetChildren()) do
                                        if not _G.AutoSteal then break end
                                        
                                        local podium = spawn:FindFirstChild("Podium")
                                        if podium then
                                            local attachment = podium:FindFirstChild("Attachment")
                                            if attachment then
                                                -- Find the exact ProximityPrompt the game uses for stealing
                                                local stealPrompt = attachment:FindFirstChild("Steal") or attachment:FindFirstChildWhichIsA("ProximityPrompt")
                                                
                                                if stealPrompt and stealPrompt.Enabled then
                                                    -- 1. Teleport to the podium
                                                    hrp.CFrame = podium.CFrame * CFrame.new(0, 3, 0)
                                                    task.wait(0.2)
                                                    
                                                    -- 2. Force the prompt to trigger instantly
                                                    fireproximityprompt(stealPrompt)
                                                    task.wait(_G.WaitTime)
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})

MainTab:Slider({
    Title = "Steal Delay (Seconds)",
    Description = "How long to wait at the podium while stealing.",
    Min = 0.1,
    Max = 2.0,
    Default = 0.5,
    Callback = function(Value)
        _G.WaitTime = Value
    end
})

MainTab:Toggle({
    Title = "Auto Noclip",
    Description = "Prevents you from getting stuck inside people's bases.",
    Default = true,
    Callback = function(Value)
        _G.Noclip = Value
    end
})
